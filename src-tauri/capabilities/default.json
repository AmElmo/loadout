{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Loadout default capabilities - enables workspace selection and config file access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.claude.json" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.agents" },
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.gemini" },
        { "path": "$HOME/.gemini/**" }
      ]
    },
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load"
  ]
}
