{
  "mcpServers": {
    "sentry": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": { "SENTRY_AUTH_TOKEN": "sntrys_FAKE_TOKEN_FOR_TESTING" }
    },
    "datadog": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@datadog/mcp-server"],
      "env": {
        "DD_API_KEY": "dd_api_FAKE_TOKEN_FOR_TESTING",
        "DD_APP_KEY": "dd_app_FAKE_TOKEN_FOR_TESTING"
      }
    },
    "jira": {
      "type": "http",
      "url": "https://mcp.atlassian.com/jira/sse",
      "headers": { "Authorization": "Bearer atlassian_FAKE_TOKEN_FOR_TESTING" }
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_TOKEN": "ghp_FAKE_TOKEN_FOR_TESTING_000" }
    }
  },
  "experiments": { "enableHooks": true },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "shell",
        "hooks": [{ "type": "command", "command": "echo '[gemini] Running shell command'" }]
      }
    ],
    "AfterTool": [
      {
        "matcher": "edit_file",
        "hooks": [{ "type": "command", "command": "pnpm lint --fix --quiet" }]
      }
    ]
  }
}
