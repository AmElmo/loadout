{
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/demo/projects"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "linear": {
      "headers": {
        "x-api-key": "lin_api_FAKE_TOKEN_FOR_TESTING"
      },
      "type": "http",
      "url": "https://mcp.linear.app/sse"
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "notion": {
      "headers": {
        "Authorization": "Bearer ntn_FAKE_TOKEN_FOR_TESTING"
      },
      "type": "http",
      "url": "https://mcp.notion.so/mcp"
    },
    "puppeteer": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "github": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx",
      "env": {
        "GITHUB_TOKEN": "ghp_FAKE_TOKEN_FOR_TESTING_000"
      },
      "type": "stdio"
    },
    "sentry": {
      "args": [
        "-y",
        "@sentry/mcp-server"
      ],
      "command": "npx",
      "env": {
        "SENTRY_AUTH_TOKEN": "sntrys_FAKE_TOKEN_FOR_TESTING"
      },
      "type": "stdio"
    },
    "slack": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "command": "npx",
      "env": {
        "SLACK_BOT_TOKEN": "xoxb-FAKE-TOKEN-FOR-TESTING",
        "SLACK_TEAM_ID": "T01ACME"
      },
      "type": "stdio"
    }
  }
}